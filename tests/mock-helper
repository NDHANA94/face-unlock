#!/usr/bin/env python3
"""Stand-in for face-unlock-helper used when developing the UI.

State lives in $MOCK_STATE (a JSON file). Run the app against it with:
    python3 scripts/ui-snapshot.py /tmp/face-unlock-snapshots
"""

import json
import os
import sys
import time

STATE = os.environ.get("MOCK_STATE", "/tmp/face-unlock-mock.json")


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"models": [], "enabled": False}


def save(state):
    with open(STATE, "w") as f:
        json.dump(state, f)


def main(cmd, *args):
    state = load()
    if cmd == "list":
        return {"ok": True, "models": state["models"]}
    if cmd == "enroll":
        time.sleep(2)
        next_id = max((m["id"] for m in state["models"]), default=-1) + 1
        state["models"].append({"id": next_id, "label": args[0], "time": int(time.time())})
        save(state)
        return {"ok": True, "models": state["models"]}
    if cmd == "remove":
        state["models"] = [m for m in state["models"] if str(m["id"]) != args[0]]
        save(state)
        return {"ok": True, "models": state["models"]}
    if cmd == "verify":
        time.sleep(1.5)
        return {"ok": True, "code": 0, "message": "Face recognized."}
    if cmd in ("enable", "disable"):
        state["enabled"] = cmd == "enable"
        save(state)
        common_auth = os.environ.get("FACE_UNLOCK_COMMON_AUTH")
        if common_auth:
            with open(common_auth, "w") as f:
                f.write("auth [success=end default=ignore] pam_howdy.so\n" if state["enabled"] else "")
        return {"ok": True, "enabled": state["enabled"]}
    if cmd == "configure":
        return {"ok": True}
    return {"ok": False, "error": f"unknown command {cmd}"}


if __name__ == "__main__":
    print(json.dumps(main(*sys.argv[1:])))
