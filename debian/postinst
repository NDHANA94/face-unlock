#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    install -d -m 755 /etc/face-unlock
    if [ ! -e /etc/face-unlock/config.ini ]; then
        install -m 644 /usr/share/face-unlock/config.ini.default /etc/face-unlock/config.ini
    fi
    install -d -m 700 /var/lib/face-unlock /var/lib/face-unlock/models /var/log/face-unlock

    # Registers the PAM profile. It is off by default ("Default: no") and is
    # switched on from the app once a face has been added.
    pam-auth-update --package
fi

#DEBHELPER#

exit 0
