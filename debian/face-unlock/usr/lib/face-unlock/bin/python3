# Run the system Python with the bundled dlib on the module path.
# Preserve PAM's effective UID when sudo has a different real UID.
# This does not grant privileges to an unprivileged caller.
# The PAM module starts the face engine through this wrapper.
PYTHONPATH=/usr/lib/face-unlock/python exec /usr/bin/python3 "$@"
